<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SE114_CallingSystem"
        tools:targetApi="31"
        tools:replace="android:allowBackup, android:label, android:supportsRtl, android:theme">
        <service
            android:name=".Activity.Page.MessageNotificationService"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name=".Activity.Page.MyScreenShareService"
            android:foregroundServiceType="mediaProjection"
            tools:node="merge"
            android:exported="false">
        </service>
        <activity
            android:name=".Activity.Page.ChatInfoActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.ChangeColorActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.ManageMembersActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.CallDetailActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Component.item_participant"
            android:exported="false" />
        <activity
            android:name=".Activity.Component.bottom_sheet_server_settings"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.DocumentViewerActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.ImageViewerActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Component.item_chat_bubble_receive"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.ChatDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Activity.Component.list_item_chat_channels"
            android:exported="false" />
        <activity
            android:name=".Activity.Component.list_item_servers"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.ServerViewerActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.HomePageActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.Page.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activity.Page.RegisterActivity"
            android:exported="false" />
    </application>

</manifest>