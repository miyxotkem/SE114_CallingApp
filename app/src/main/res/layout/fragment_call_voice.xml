<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:animateLayoutChanges="true">

    <!-- Background Wallpaper -->
    <ImageView
        android:id="@+id/bgImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app_wallpaper" />

    <!-- Top Action bar / Header -->
    <LinearLayout
        android:id="@+id/callHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvCallChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Voice Channel"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/inter" android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParticipantCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 connected"
            android:textColor="@color/discord_text_muted"
            android:fontFamily="@font/inter" android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Grid List of Voice Participants -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParticipants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/callHeader"
        app:layout_constraintBottom_toTopOf="@id/controlPanel" />

    <!-- Waiting Overlay for Voice Call (Single Participant Waiting) -->
    <LinearLayout
        android:id="@+id/layoutWaiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieRinging"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:lottie_rawRes="@raw/lottie_ringing"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang chờ người khác tham gia..."
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Control Floating bar (Glassmorphism layout) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="#59131622"
        app:cardCornerRadius="36dp"
        app:cardElevation="10dp"
        app:strokeColor="#26FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <!-- Video cam Toggle -->
            <ImageButton
                android:id="@+id/btnToggleVideo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/call_control_bg"
                android:src="@drawable/ic_videocam_off"
                android:scaleType="centerInside"
                android:padding="14dp"
                app:tint="@color/discord_text_secondary"
                android:contentDescription="Toggle video" />

            <!-- Mic Toggle -->
            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/call_control_bg"
                android:src="@drawable/ic_mic_on"
                android:scaleType="centerInside"
                android:padding="14dp"
                app:tint="@color/discord_text_secondary"
                android:contentDescription="Toggle audio" />

            <!-- Screen Share Toggle -->
            <ImageButton
                android:id="@+id/btnShareScreen"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/call_control_bg"
                android:src="@drawable/ic_screen_share_off"
                android:scaleType="centerInside"
                android:padding="14dp"
                app:tint="@color/discord_text_secondary"
                android:contentDescription="Share screen" />

            <!-- Disconnect call -->
            <ImageButton
                android:id="@+id/btnEndCall"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/discord_red"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:scaleType="centerInside"
                android:padding="14dp"
                app:tint="@color/white"
                android:contentDescription="End call" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
