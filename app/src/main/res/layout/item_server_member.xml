<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_member_item">

    <!-- Avatar Container -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMemberAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/discord_dark_elevated"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- User Name Initials TextView (shown if there is no profilePic) -->
                <TextView
                    android:id="@+id/tvMemberInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:visibility="gone" />

                <!-- Profile Pic ImageView (shown if profilePic is present) -->
                <ImageView
                    android:id="@+id/ivMemberAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Default user placeholder icon if nothing is loaded yet -->
                <ImageView
                    android:id="@+id/ivMemberPlaceholder"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user"
                    app:tint="@color/discord_text_secondary" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Indicator -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vStatusIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            app:cardCornerRadius="7dp"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/discord_dark_alt"
            app:cardBackgroundColor="@color/discord_text_muted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- Name and Role Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"/>

            <TextView
                android:id="@+id/tvMemberRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_pill_dark"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Voice Status Group -->
        <LinearLayout
            android:id="@+id/layoutVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_mic_on"
                app:tint="#23A559"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvMemberStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice channel description"
                android:textColor="#23A559"
                android:textSize="11sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnMemberOptions"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/icon_tint" />
</LinearLayout>