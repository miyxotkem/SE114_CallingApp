<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_alter">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="36dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_backbutton"
            app:tint="@color/tint_default" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Theme"
            android:textColor="@color/tint_default"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- KHUNG PREVIEW GIỐNG MESSENGER -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_default">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top bar của app -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topBarPreview"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="#7289DA">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Server Preview"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Khung Chat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">
                <!-- Tin nhận (Xám) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi! How do you like this theme?"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"
                    android:layout_gravity="start"/>
                <!-- Tin gửi (Màu Accent) -->
                <TextView
                    android:id="@+id/tvSentMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="It looks amazing! hjhj"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/edittext_background"
                    android:backgroundTint="#7289DA"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Colors"
        android:textAlignment="center"
        android:textColor="@color/tint_default"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Bảng 10 Màu -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:columnCount="5"
        android:rowCount="2">
        <com.google.android.material.card.MaterialCardView android:id="@+id/color1" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#7289DA"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color2" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#F44336"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color3" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#E91E63"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color4" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#9C27B0"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color5" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#673AB7"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color6" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#2196F3"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color7" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#00BCD4"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color8" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#4CAF50"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color9" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#FF9800"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/color10" android:layout_width="45dp" android:layout_height="45dp" app:cardCornerRadius="25dp" android:layout_margin="8dp" app:cardBackgroundColor="#795548"/>
    </GridLayout>

    <!-- Nút Save -->
    <Button
        android:id="@+id/btnSaveTheme"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="Apply Theme"
        android:textColor="#FFFFFF" />
</LinearLayout>