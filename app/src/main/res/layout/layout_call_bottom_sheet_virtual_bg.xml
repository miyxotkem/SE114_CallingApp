<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/discord_dark_floating"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle drag bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/discord_divider"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hiệu ứng &amp; Bộ lọc Video"
        android:textColor="@color/discord_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter"/>

    <!-- Section 1: Virtual Background -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bộ lọc nền Video"
        android:textColor="@color/discord_text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/discord_dark_alt"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/btnBgNormal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Không dùng (Bình thường)"
                android:drawableStart="@drawable/ic_close"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgBlur"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Làm mờ nền (Background Blur)"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgColor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Đổi màu nền tối (Discord Style)"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgStudy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Phòng Làm Việc Ấm Áp (Cozy Study)"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgGaming"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Góc Gaming Cyberpunk"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgNature"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Rừng Thông Sương Mù (Misty Forest)"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section 3: Color Filters -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bộ lọc biến dạng khuôn mặt"
        android:textColor="@color/discord_text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <!-- Filter Normal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterNormal"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/discord_text_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gốc"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter ApeFace -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterApeFace"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐵"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mặt Vượn"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter BigEyes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterBigEyes"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👀"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mắt To"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter BigMouth -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterBigMouth"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👄"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mồm Rộng"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter Alien -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterAlien"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👽"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mặt Alien"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter SmallEyes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterSmallEyes"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😑"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mắt Híp"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter SmallMouth -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnFilterSmallMouth"
                android:layout_width="80dp"
                android:layout_height="70dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😗"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mồm Nhỏ"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Section 4: Sticker & Frame Overlays -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trang trí Sticker &amp; Khung"
        android:textColor="@color/discord_text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <!-- Sticker None -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStickerNone"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/discord_text_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không dùng"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sticker Crown -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStickerCrown"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sticker_crown"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vương miện"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sticker Glasses -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStickerGlasses"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sticker_glasses"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kính ngầu"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sticker CatEars -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStickerCatEars"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sticker_cat_ears"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tai mèo"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sticker Frame -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStickerFrame"
                android:layout_width="80dp"
                android:layout_height="70dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sticker_frame"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trái tim"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
