<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/discord_dark_floating"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle drag bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/discord_divider"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bộ lọc nền Video"
        android:textColor="@color/discord_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter"/>

    <!-- Options List Group Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/discord_dark_alt"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/btnBgNormal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Không dùng (Bình thường)"
                android:drawableStart="@drawable/ic_close"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgBlur"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Làm mờ nền (Background Blur)"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/btnBgColor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Đổi màu nền tối (Discord Style)"
                android:drawableStart="@drawable/ic_palette"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
