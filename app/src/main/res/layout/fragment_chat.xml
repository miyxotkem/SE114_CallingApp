<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/discord_dark_base">

    <!-- Header Toolbar (Discord Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardBackgroundColor="@color/discord_dark_alt"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                app:tint="@color/discord_text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tvChannelHash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="#"
                android:textColor="@color/discord_text_muted"
                android:textSize="20sp"
                android:fontFamily="@font/inter" android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="general"
                android:textColor="@color/discord_text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/inter" android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/tvChannelHash"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />



            <ImageView
                android:id="@+id/btnVoiceCall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_call"
                app:tint="@color/discord_text_primary"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/btnVideoCall"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/btnVideoCall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_videocam_on"
                app:tint="@color/discord_text_primary"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/ivOnlineStatus"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/ivOnlineStatus"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_circle"
                app:tint="@color/discord_green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Pinned Message Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutPinnedMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/discord_dark_elevated"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvPinIconHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/tvPinIconHeader"
                app:layout_constraintEnd_toStartOf="@id/btnViewPinnedMessages"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvPinnedMessageHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pinned_messages_title"
                    android:textColor="@color/discord_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/tvPinnedMessageContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/discord_text_secondary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnViewPinnedMessages"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/discord_text_muted"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Message List (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutPinnedMessage"
        app:layout_constraintBottom_toTopOf="@id/cardMentionSuggestions" />

    <!-- Mention Suggestions Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMentionSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/discord_dark_floating"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/discord_blurple"
        app:strokeWidth="1dp"
        android:visibility="gone"
        app:layout_constraintHeight_max="160dp"
        app:layout_constraintBottom_toTopOf="@id/typingIndicatorLayout">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMentionSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/typingIndicatorLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvReplyingToLayout">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieTyping"
            android:layout_width="50dp"
            android:layout_height="28dp"
            app:lottie_rawRes="@raw/lottie_typing"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/tvTypingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/someone_is_typing"
            android:textColor="@color/discord_text_muted"
            android:textSize="12sp"
            android:fontFamily="@font/inter" />

    </LinearLayout>

    <!-- Replying to UI Header Bar (Messenger Style) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tvReplyingToLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/bg_bottom_sheet_secondary"
        android:backgroundTint="@color/discord_dark_alt"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/inputAreaPanel">

        <ImageView
            android:id="@+id/ivReplyIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_revert"
            app:tint="@color/discord_blurple"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutReplyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintStart_toEndOf="@id/ivReplyIcon"
            app:layout_constraintEnd_toStartOf="@id/cardReplyPreviewImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvReplyHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/replying_to"
                android:textColor="@color/discord_blurple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"/>

            <TextView
                android:id="@+id/tvReplyingToText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/discord_text_primary"
                android:fontFamily="@font/inter"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReplyPreviewImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btnCancelReply"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/ivReplyPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/btnCancelReply"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"
            app:tint="@color/discord_text_muted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Input Control Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inputAreaPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnAttachHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            app:tint="@color/discord_text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/messageCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="@color/discord_dark_elevated"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toEndOf="@id/btnAttachHome"
            app:layout_constraintEnd_toStartOf="@id/sendButtonContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <EditText
                android:id="@+id/edtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Message #general"
                android:textColorHint="@color/discord_text_muted"
                android:textColor="@color/discord_text_primary"
                android:maxLines="4"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textSize="14sp"
                android:fontFamily="@font/inter"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Container cố định chứa 2 nút Send & Mic để messageCard luôn constrain đúng -->
        <FrameLayout
            android:id="@+id/sendButtonContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_send"
                app:tint="@color/discord_blurple"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnRecordAudio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic_on"
                app:tint="@color/discord_text_secondary"
                android:visibility="visible" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Recording Control Area (Mockup Style) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recordingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_recording_panel"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Drag Handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="#40FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sub-header Instruction Text -->
        <TextView
            android:id="@+id/tvRecordInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/record_swipe_hint"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/inter"
            app:layout_constraintTop_toBottomOf="@id/dragHandle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Middle Row: Capsule and Mic Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/middleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvRecordInstruction">

            <!-- Audio Player Capsule -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/audioCapsule"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_audio_capsule"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardMicResume"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Play/Pause Button -->
                <ImageButton
                    android:id="@+id/btnRecordPlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Waveform visualization -->
                <LinearLayout
                    android:id="@+id/layoutWaveform"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constraintStart_toEndOf="@id/btnRecordPlay"
                    app:layout_constraintEnd_toStartOf="@id/tvRecordTimer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <View android:layout_width="2dp" android:layout_height="8dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="16dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="18dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="6dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="20dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="16dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="8dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="18dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="6dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="#FFFFFF" android:layout_marginHorizontal="1dp"/>

                </LinearLayout>

                <!-- Timer -->
                <TextView
                    android:id="@+id/tvRecordTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Circular Mic/Resume Button Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMicResume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#1A2D2D"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnRecordPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic_on"
                    app:tint="#FFFFFF" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Controls Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/middleRow"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Trash Button -->
            <ImageButton
                android:id="@+id/btnRecordCancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/discord_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Reset/Re-record Button -->
            <ImageButton
                android:id="@+id/btnRecordReset"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_revert"
                app:tint="@color/discord_green"
                app:layout_constraintStart_toEndOf="@id/btnRecordCancel"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Send Button Container -->
            <LinearLayout
                android:id="@+id/btnRecordSend"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_send_button"
                android:paddingHorizontal="20dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/send_text"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <ImageView
                    android:id="@+id/btnRecordSendIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_send"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
