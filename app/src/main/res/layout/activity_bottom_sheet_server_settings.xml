<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_alter">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Settings"
        android:textColor="@color/tint_default"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etServerNameSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter new server name"
        android:inputType="text"
        android:textColor="@color/tint_default"
        android:textColorHint="@color/tint_default"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnRenameServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rename Server"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnDeleteServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Server"
        android:backgroundTint="#D32F2F"
        android:textColor="@android:color/white"/>

</LinearLayout>