<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/discord_dark_base">

    <!-- Header Toolbar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardBackgroundColor="@color/discord_dark_alt"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_backbutton"
                app:tint="@color/discord_text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit User Profile"
                android:textColor="@color/discord_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Edit Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- PREVIEW CARD SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE PREVIEW"
                android:textColor="@color/discord_text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- Live Preview Card (Looks like the real Profile tab) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Preview Banner + Avatar Stack -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp">

                        <!-- Preview Cover / Banner -->
                        <ImageView
                            android:id="@+id/ivEditCoverPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:background="@color/discord_blurple"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Banner Overlay Cover layer to show edit state -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:background="#40000000"
                            android:clickable="false" />

                        <!-- Camera Edit Icon on Banner -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_horizontal|top"
                            android:layout_marginTop="44dp"
                            app:cardBackgroundColor="#CC000000"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            android:clickable="false">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/icon_edit"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Overlapping Preview Avatar -->
                        <FrameLayout
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="start|bottom"
                            android:layout_marginStart="16dp"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivEditAvatar"
                                android:layout_width="86dp"
                                android:layout_height="86dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:padding="2dp"
                                android:background="@color/discord_dark_alt"
                                android:src="@drawable/icon_user"
                                app:strokeColor="@color/discord_dark_alt"
                                app:strokeWidth="4dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Avatar Dark Overlay -->
                            <View
                                android:layout_width="86dp"
                                android:layout_height="86dp"
                                android:layout_gravity="center"
                                android:background="#40000000"
                                android:clickable="false"
                                android:importantForAccessibility="no" />

                            <!-- Edit Pencil Icon overlay on Avatar -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_edit_pencil"
                                app:tint="@color/white"
                                android:clickable="false" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap banner or avatar to edit images"
                            android:textColor="@color/discord_text_muted"
                            android:textSize="11sp"
                            android:layout_gravity="end|bottom"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EDIT VALUES SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER DETAILS"
                android:textColor="@color/discord_text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- Input Fields Form inside elegant CardView -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Display Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColorHint="@color/discord_text_muted"
                        app:hintTextColor="@color/discord_blurple"
                        app:boxBackgroundColor="@color/discord_dark_floating"
                        app:boxStrokeColor="@color/discord_blurple"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="DISPLAY NAME"
                            android:textColor="@color/discord_text_primary"
                            android:inputType="textPersonName"
                            android:padding="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Bio -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColorHint="@color/discord_text_muted"
                        app:hintTextColor="@color/discord_blurple"
                        app:boxBackgroundColor="@color/discord_dark_floating"
                        app:boxStrokeColor="@color/discord_blurple"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="ABOUT ME (BIO)"
                            android:textColor="@color/discord_text_primary"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:padding="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Workplace -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColorHint="@color/discord_text_muted"
                        app:hintTextColor="@color/discord_blurple"
                        app:boxBackgroundColor="@color/discord_dark_floating"
                        app:boxStrokeColor="@color/discord_blurple"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWorkplace"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="WORK/EDUCATION"
                            android:textColor="@color/discord_text_primary"
                            android:inputType="textPersonName"
                            android:padding="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Hobbies -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColorHint="@color/discord_text_muted"
                        app:hintTextColor="@color/discord_blurple"
                        app:boxBackgroundColor="@color/discord_dark_floating"
                        app:boxStrokeColor="@color/discord_blurple"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHobbies"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="HOBBIES"
                            android:textColor="@color/discord_text_primary"
                            android:inputType="textPersonName"
                            android:padding="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date of Birth -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/discord_text_muted"
                        app:hintTextColor="@color/discord_blurple"
                        app:boxBackgroundColor="@color/discord_dark_floating"
                        app:boxStrokeColor="@color/discord_blurple"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDob"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="DATE OF BIRTH"
                            android:textColor="@color/discord_text_primary"
                            android:inputType="textPersonName"
                            android:padding="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save button -->
            <android.widget.Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_button_primary"
                android:text="Save Changes"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="false"
                android:layout_marginBottom="48dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
