<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/discord_dark_floating"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle drag bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/discord_divider"
        android:layout_marginBottom="16dp"/>

    <!-- Quick Reactions Horizontal Row (Discord Style) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/discord_dark_alt"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/discord_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/btnReactLike"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="👍"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnReactLove"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="❤️"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnReactHaha"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="😂"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnReactWow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="😮"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnReactSad"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="😢"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnReactAngry"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="😡"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnReactCustom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="➕"
                android:textSize="18sp"
                android:textColor="@color/discord_text_secondary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Options List Group Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/discord_dark_alt"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <!-- Remove Reaction Option -->
            <TextView
                android:id="@+id/btnRemoveReaction"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/remove_reaction"
                android:drawableStart="@drawable/ic_close"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Divider (dynamically shown or hidden) -->
            <View
                android:id="@+id/dividerAction"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginHorizontal="16dp"
                android:visibility="gone"/>

            <!-- Pin Message Option -->
            <TextView
                android:id="@+id/btnPin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/pin_message"
                android:drawableStart="@drawable/ic_pin"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Set Reminder Option -->
            <TextView
                android:id="@+id/btnSetReminder"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/set_message_reminder"
                android:drawableStart="@drawable/ic_alarm"
                app:drawableTint="@color/discord_text_secondary"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Delete Message Option (Red destructive color) -->
            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/delete_message"
                android:drawableStart="@drawable/ic_delete"
                app:drawableTint="@color/discord_red"
                android:drawablePadding="12dp"
                android:textColor="@color/discord_red"
                android:textSize="15sp"
                android:fontFamily="@font/inter" android:textStyle="bold"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>