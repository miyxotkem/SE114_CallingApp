<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_member_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- File Icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/accent_surface"
        app:cardElevation="0dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_modern"
            app:tint="@color/accent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- File Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSharedFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Document.pdf"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            android:fontFamily="@font/inter"/>

        <TextView
            android:id="@+id/tvSharedFileDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 11, 2026"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"/>
    </LinearLayout>

    <!-- Download icon -->
    <ImageView
        android:id="@+id/btnDownloadFile"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_download"
        app:tint="@color/accent" />

</LinearLayout>
