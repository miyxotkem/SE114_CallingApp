<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/discord_dark_alt"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/handle_bar" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_theme_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:fontFamily="@font/inter"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/discord_divider"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Preview Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_preview_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter" />

    <!-- KHUNG PREVIEW -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_secondary"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top bar preview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topBarPreview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:cardCornerRadius="0dp"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#5865F2">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#"
                        android:textColor="#BFFFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="@font/inter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="general"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Mock Icons -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="12dp"
                        android:alpha="0.8" />
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_user"
                        app:tint="#FFFFFF"
                        android:alpha="0.8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chat preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="12dp">

                <!-- Received Message Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="8dp">

                    <!-- Mock Avatar -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:cardCornerRadius="14dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/discord_blurple"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="K"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kaitlyn"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10:42 AM"
                                android:textColor="@color/text_secondary"
                                android:textSize="8sp"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/inter" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_preview_msg_received"
                            android:textColor="@color/bubble_text_received"
                            android:background="@drawable/bg_chat_left"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Sent Message Row -->
                <TextView
                    android:id="@+id/tvSentMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_preview_msg_sent"
                    android:textColor="@color/bubble_text_sent"
                    android:background="@drawable/border_chat"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_gravity="end"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Color Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_accent_color_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter"/>

    <!-- Color Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:columnCount="5"
        android:rowCount="2"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp">
        
        <!-- Color 1: Blurple -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color1" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#5865F2" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 2: Green -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color2" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#23A559" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 3: Red -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color3" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#DA373C" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 4: Yellow/Gold -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color4" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#FEE75C" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#4E5058" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 5: Pink -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color5" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#EB459E" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 6: Blue -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color6" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#00A8FC" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check6"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 7: Teal -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color7" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#00D2C4" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check7"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 8: Purple -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color8" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#8A2BE2" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check8"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 9: Orange -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color9" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#FF5722" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check9"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
        
        <!-- Color 10: Charcoal/Slate -->
        <com.google.android.material.card.MaterialCardView 
            android:id="@+id/color10" 
            android:layout_width="52dp" 
            android:layout_height="52dp" 
            app:cardCornerRadius="26dp" 
            android:layout_margin="6dp" 
            app:cardBackgroundColor="#4E5058" 
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/divider"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/check10"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveTheme"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/apply_theme_button"
        android:textColor="@color/text_on_accent"
        android:backgroundTint="@color/accent"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/text_on_accent"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:elevation="0dp" />
</LinearLayout>
