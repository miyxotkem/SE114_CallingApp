<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="1dp">

    <TextView
        android:id="@+id/tvReplyHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#949BA4"
        android:textSize="11sp"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutRepliedContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_replied_bubble_sent"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="220dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReplyHeader">

        <ImageView
            android:id="@+id/ivRepliedImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textRepliedTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/inter"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:layout_marginTop="2dp"
        app:layout_goneMarginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRepliedContainer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border_chat"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:maxWidth="280dp">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="200dp"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:id="@+id/layoutFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/file_bg"
                android:padding="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_file_modern"
                    app:tint="@color/bubble_text_sent" />

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Tài liệu đính kèm"
                    android:textColor="@color/bubble_text_sent"
                    android:fontFamily="@font/inter" android:textStyle="bold"
                    android:maxWidth="160dp"
                    android:ellipsize="middle"
                    android:singleLine="true"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAudio"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_dark_tint"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/white" />

                <LinearLayout
                    android:id="@+id/layoutWaveform"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvAudioTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPinnedIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_pin"
                    app:tint="#B3FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Đã ghim"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <TextView
                android:id="@+id/textMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bubble_text_sent"
                android:textSize="16sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_reaction_bubble"
        android:elevation="4dp"
        android:padding="4dp"
        android:text="❤️"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/cardBubble"
        app:layout_constraintStart_toStartOf="@id/cardBubble"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="-6dp"
        android:fontFamily="@font/inter"/>

    <TextView
        android:id="@+id/textTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="@font/inter"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/cardBubble"
        app:layout_constraintTop_toBottomOf="@id/cardBubble" />

</androidx.constraintlayout.widget.ConstraintLayout>