<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/discord_dark_base">

    <!-- Server Colored Top Header -->
    <RelativeLayout
        android:id="@+id/serverBanner"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="12dp"
        android:background="@color/discord_blurple">

        <!-- Server Avatar overlayed on header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/serverAvatarCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/discord_dark_deep"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvAvatarLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="S"
                android:textColor="@color/discord_blurple"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivServerAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Server Text Titles -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/serverAvatarCard"
            android:layout_toStartOf="@id/btnServerSettings"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvServerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Name"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvServerDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description goes here"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnServerSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_more_vert"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"/>

    </RelativeLayout>

    <!-- Main Channels List Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Shimmer Loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerViewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            app:shimmer_auto_start="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View android:layout_width="100dp" android:layout_height="14dp" android:background="#1A000000" android:layout_marginBottom="16dp"/>
                <include layout="@layout/item_server_channel_shimmer" />
                <include layout="@layout/item_server_channel_shimmer" />
                
                <View android:layout_width="120dp" android:layout_height="14dp" android:background="#1A000000" android:layout_marginTop="24dp" android:layout_marginBottom="16dp"/>
                <include layout="@layout/item_server_channel_shimmer" />

                <View android:layout_width="110dp" android:layout_height="14dp" android:background="#1A000000" android:layout_marginTop="24dp" android:layout_marginBottom="16dp"/>
                <include layout="@layout/item_server_channel_shimmer" />
                <include layout="@layout/item_server_channel_shimmer" />

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Channels Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/channelsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- TEXT CHANNELS Zone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp">

                    <View
                        android:id="@+id/chatNeonStrip"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/discord_blurple" />

                    <ImageView
                        android:id="@+id/expandChatZone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/discord_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="TEXT CHANNELS"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="@color/discord_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnAddChannel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_add"
                        app:tint="@color/discord_text_secondary" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChatChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp"/>

                <!-- VOICE CHANNELS Zone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="16dp">

                    <View
                        android:id="@+id/callNeonStrip"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/discord_blurple" />

                    <ImageView
                        android:id="@+id/expandCallZone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/discord_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="VOICE CHANNELS"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="@color/discord_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnAddCallChannel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_add"
                        app:tint="@color/discord_text_secondary" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCallChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp"/>

                <!-- POST CHANNELS Zone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="16dp">

                    <View
                        android:id="@+id/postNeonStrip"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/discord_blurple" />

                    <ImageView
                        android:id="@+id/expandPostZone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/discord_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="POST CHANNELS"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="@color/discord_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter" android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnAddPostChannel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_add"
                        app:tint="@color/discord_text_secondary" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPostChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
