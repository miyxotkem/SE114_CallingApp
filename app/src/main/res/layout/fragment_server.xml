<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/discord_dark_deep">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Hero Banner -->
            <View
                android:id="@+id/serverBanner"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/discord_blurple"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Channels Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="130dp"
                app:cardBackgroundColor="@color/discord_dark_base"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="72dp"
                    android:paddingBottom="40dp">

                    <!-- TEXT CHANNELS Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="16dp">

                        <View
                            android:id="@+id/chatNeonStrip"
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/discord_blurple" />

                        <ImageView
                            android:id="@+id/expandChatZone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/icon_expandbutton"
                            app:tint="@color/discord_text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="TEXT CHANNELS"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:textColor="@color/discord_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold" />

                        <ImageView
                            android:id="@+id/btnAddChannel"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/icon_add"
                            app:tint="@color/discord_text_secondary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvChatChannels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- VOICE CHANNELS Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="24dp">

                        <View
                            android:id="@+id/callNeonStrip"
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/discord_blurple" />

                        <ImageView
                            android:id="@+id/expandCallZone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/icon_expandbutton"
                            app:tint="@color/discord_text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="VOICE CHANNELS"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:textColor="@color/discord_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold" />

                        <ImageView
                            android:id="@+id/btnAddCallChannel"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/icon_add"
                            app:tint="@color/discord_text_secondary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCallChannels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Server Avatar Overlay -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serverAvatarCard"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="86dp"
                app:cardBackgroundColor="@color/discord_dark_deep"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/discord_dark_base"
                app:strokeWidth="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="G"
                    android:textColor="@color/discord_blurple"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-black" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Server Text Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="140dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/serverAvatarCard"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvServerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAMING ARENA"
                    android:textColor="@color/discord_text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        app:cardBackgroundColor="@color/discord_green"
                        app:cardCornerRadius="5dp"
                        app:strokeWidth="0dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Server Online"
                        android:textColor="@color/discord_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- floating Header Actions -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="#4D000000"
        app:cardCornerRadius="20dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_backbutton"
            app:tint="@color/white" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#4D000000"
        app:cardCornerRadius="20dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnServerSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_more_vert"
            app:tint="@color/white" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
