<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D3D3D3"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/btnReactLike"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="👍 Thích"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnReactLove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="❤️ Yêu thích"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnReactCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="➕ Tùy chỉnh..."
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnRemoveReaction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="💔 Gỡ cảm xúc"
        android:textSize="16sp"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="🗑️ Thu hồi tin nhắn"
        android:textColor="#F44336"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>