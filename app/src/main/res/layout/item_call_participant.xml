<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/call_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#2D2D4A"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- STICKER OVERLAYS -->
        <!-- Crown sticker -->
        <ImageView
            android:id="@+id/ivStickerCrown"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_sticker_crown"
            android:visibility="gone" />

        <!-- Sunglasses sticker -->
        <ImageView
            android:id="@+id/ivStickerGlasses"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_sticker_glasses"
            android:visibility="gone" />

        <!-- Cat Ears sticker -->
        <ImageView
            android:id="@+id/ivStickerCatEars"
            android:layout_width="160dp"
            android:layout_height="70dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_sticker_cat_ears"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Full frame overlay -->
        <ImageView
            android:id="@+id/ivStickerFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_sticker_frame"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- WARP OVERLAYS -->
        <ImageView
            android:id="@+id/ivWarpEyeLeft"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivWarpEyeRight"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivWarpMouth"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAudioWave"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:lottie_rawRes="@raw/lottie_audio_wave"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#2B2D31"
            app:strokeColor="#23A559"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivUserProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_participant_name"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="User Name"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/ivMuteStatus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#DA373C"
            android:padding="6dp"
            android:src="@drawable/ic_mic_off"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnParticipantOptions"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="12dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#B01E1F22"
            android:padding="5dp"
            android:src="@drawable/ic_more_vert"
            android:rotation="90"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>