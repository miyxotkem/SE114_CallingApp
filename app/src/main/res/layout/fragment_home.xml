<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/discord_dark_base">

    <!-- Left Sidebar (Servers Column - Discord Style) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="@color/discord_dark_deep"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:gravity="center_horizontal">

            <!-- Home Button / Direct Messages Shortcut -->
            <FrameLayout
                android:id="@+id/btn_sidebar_home"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Active Indicator Pill on Left Edge -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="36dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@color/white" />

                <!-- Rounded square icon matching Discord active state shape -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_button_primary"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="@android:color/white" />
                </FrameLayout>
            </FrameLayout>

            <!-- Divider separating Home button from other servers -->
            <View
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/discord_divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Scrollable Server list (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <!-- Create Server Button immediately below the list -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvServerCreate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/discord_dark_alt"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/discord_divider"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/discord_green" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Right Content Area (Direct Messages and Actions) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/discord_dark_base">

        <!-- Sleek Search Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:background="@color/discord_dark_base">

            <!-- Search Container -->
            <LinearLayout
                android:id="@+id/btn_search_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chat_input"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/discord_text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Find or start a conversation"
                    android:textColor="@color/discord_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Add Friend Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddFriend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                app:cardBackgroundColor="@color/discord_dark_elevated"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/discord_divider"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/discord_green" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/discord_divider" />

        <!-- Scrollable content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Friends Shortcut Row -->
                <LinearLayout
                    android:id="@+id/btnManageFriends"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chat_input"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Friends"
                        android:textColor="@color/discord_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter" android:textStyle="bold" />

                    <!-- Online Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online"
                        android:textColor="@color/discord_green"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter" android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_chat_input" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/discord_divider"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- DIRECT MESSAGES Category Sub-Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="DIRECT MESSAGES"
                        android:textColor="@color/discord_text_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter" android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <ImageView
                        android:id="@+id/btn_new_dm"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="2dp"
                        android:src="@android:drawable/ic_menu_add"
                        app:tint="@color/discord_text_muted"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- DMs Placeholder or list (Clean modern look) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_user"
                        app:tint="@color/discord_text_muted"
                        android:alpha="0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No direct messages yet"
                        android:textColor="@color/discord_text_muted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</LinearLayout>
