<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/discord_divider"
        android:layout_marginBottom="24dp" />

    <!-- Pulsing Avatar Ring container -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCallerAvatar"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            app:strokeColor="@color/discord_blurple"
            app:strokeWidth="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caller Name"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCallTypeDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming voice call..."
        android:textColor="@color/discord_text_muted"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:layout_marginBottom="32dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Decline Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDeclineCall"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="@color/discord_red"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Answer Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAnswerCall"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="@color/discord_green"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_call"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
