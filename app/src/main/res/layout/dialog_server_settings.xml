<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/discord_dark_alt"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Header / Banner Section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- Banner Color -->
        <View
            android:id="@+id/viewServerBanner"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@color/discord_blurple" />

        <!-- Drag handle over the banner -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#80FFFFFF" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:text="Overview"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/inter"
            android:textStyle="bold" />

        <!-- Avatar overlapping the banner -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="60dp"> <!-- Push it down to overlap -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServerAvatarSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/discord_dark_elevated"
                app:cardCornerRadius="45dp"
                app:strokeColor="@color/discord_dark_alt"
                app:strokeWidth="4dp">

                <TextView
                    android:id="@+id/tvAvatarLetterSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="S"
                    android:textColor="@color/discord_text_primary"
                    android:textSize="32sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivServerAvatarSettings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Icon Overlay -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="@color/discord_text_primary"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/discord_dark_alt"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/btnEditAvatar"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/discord_dark_base" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>
    
    <TextView
        android:id="@+id/btnRemoveAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove Picture"
        android:textColor="@color/danger"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground"
        android:layout_marginBottom="16dp"/>

    <!-- General Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/discord_dark_base"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Identity"
                android:textColor="@color/discord_text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etServerNameSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Server Name"
                android:inputType="text"
                android:textColor="@color/discord_text_primary"
                android:textColorHint="@color/discord_text_muted"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/discord_divider"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etServerDescriptionSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Add a short description..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/discord_text_secondary"
                android:textColorHint="@color/discord_text_muted"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveServerDetails"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:text="Save"
                app:cornerRadius="22dp"
                android:backgroundTint="@color/discord_blurple"
                android:textColor="@color/white"
                android:fontFamily="@font/inter"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Settings Options Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/discord_dark_base"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnManageMembers"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/discord_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Manage members"
                    android:textColor="@color/discord_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/discord_divider" />

            <LinearLayout
                android:id="@+id/btnChangeColor"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_palette"
                    app:tint="@color/discord_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Change accent color"
                    android:textColor="@color/discord_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Danger Zone Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/discord_dark_base"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnLeaveServer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/danger" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Leave server"
                    android:textColor="@color/danger"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/discord_divider" />

            <LinearLayout
                android:id="@+id/btnDeleteServer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/danger" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Delete server"
                    android:textColor="@color/danger"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>