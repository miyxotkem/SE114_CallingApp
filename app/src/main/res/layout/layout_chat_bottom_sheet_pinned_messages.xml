<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/discord_dark_floating"
    android:orientation="vertical"
    android:padding="16dp"
    android:minHeight="400dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/discord_divider"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvPinnedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📌 Tin Nhắn Đã Ghim"
        android:textColor="@color/discord_text_primary"
        android:textSize="18sp"
        android:fontFamily="@font/inter" android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:letterSpacing="0.02"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/discord_divider"
        android:layout_marginBottom="12dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPinnedMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:padding="4dp"
            android:clipToPadding="false"/>

        <LinearLayout
            android:id="@+id/tvNoPinnedMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌"
                android:textSize="48sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tin nhắn ghim nào trong phòng này."
                android:textColor="@color/discord_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
