<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="36dp">
            
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/icon_tint"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Theme"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter"/>
        </RelativeLayout>

        <!-- Preview Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME PREVIEW"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter" />

        <!-- KHUNG PREVIEW -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_secondary"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top bar preview -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/topBarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:cardCornerRadius="0dp"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#5865F2">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#"
                            android:textColor="#BFFFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/inter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="general"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Mock Icons -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="16dp"
                            android:alpha="0.8" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user"
                            app:tint="#FFFFFF"
                            android:alpha="0.8" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chat preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="16dp">

                    <!-- Received Message Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="12dp">

                        <!-- Mock Avatar -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardCornerRadius="16dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/discord_blurple"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="K"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity=""
                                android:layout_marginBottom="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Kaitlyn"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/inter" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Today at 10:42 AM"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="9sp"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/inter" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hi! How do you like this new theme?"
                                android:textColor="@color/bubble_text_received"
                                android:background="@drawable/bg_chat_left"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sent Message Row -->
                    <TextView
                        android:id="@+id/tvSentMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="It looks absolutely stunning! ✨"
                        android:textColor="@color/bubble_text_sent"
                        android:background="@drawable/border_chat"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_gravity="end"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Color Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT ACCENT COLOR"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/inter"/>

        <!-- Color Grid -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:columnCount="5"
            android:rowCount="2"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="32dp">
            
            <!-- Curated vibrant HSL colors -->
            <!-- Color 1: Blurple -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color1" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#5865F2" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 2: Green -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color2" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#23A559" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 3: Red -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color3" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#DA373C" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 4: Yellow/Gold -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color4" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#FEE75C" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#4E5058" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 5: Pink -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color5" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#EB459E" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check5"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 6: Blue -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color6" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#00A8FC" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check6"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 7: Teal -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color7" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#00D2C4" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check7"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 8: Purple -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color8" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#8A2BE2" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check8"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 9: Orange -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color9" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#FF5722" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check9"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Color 10: Charcoal/Slate -->
            <com.google.android.material.card.MaterialCardView 
                android:id="@+id/color10" 
                android:layout_width="54dp" 
                android:layout_height="54dp" 
                app:cardCornerRadius="27dp" 
                android:layout_margin="8dp" 
                app:cardBackgroundColor="#4E5058" 
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/check10"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTheme"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="32dp"
            android:text="Apply Theme"
            android:textColor="@color/text_on_accent"
            android:backgroundTint="@color/accent"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/text_on_accent"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:elevation="2dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>